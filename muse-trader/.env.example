# ── Required: read by the code today ──────────────────────────
ODDS_API_KEY=                    # the-odds-api.com dashboard
DISCORD_WEBHOOK_URL=             # webhook for #calls
DISCORD_WEBHOOK_OPS=             # webhook for #ops: heartbeat, errors, credit usage
MINDGOD_DB_PATH=/data/mindgod.db # not a secret; must be on persistent storage

# ── Optional: read by the code ──────────────────────────────────
# ODDS_API_MARKETS=h2h,spreads,totals  # default; the API charges 1 credit
# per market per poll, so h2h alone costs 1 credit/poll vs 3. Moneyline
# listings only look up h2h outcomes; keep spreads,totals when running
# spread/total listings.
# ODDS_API_REGIONS=us,eu  # default; Pinnacle is a eu-region book, so
# regions=us alone never returns it. Whether the eu leg costs extra
# credits is reported to #ops after every poll (x-requests-last).
# MINDGOD_SOFT_STARTUP=1  # explicit flag only: start with missing secrets
# instead of failing loudly (tests, dev).

# ── Planned: not read yet, uncomment when the code lands ─────
# Per-channel Discord routing
# DISCORD_WEBHOOK_REVIEW=        # unmapped markets, quarantined listings
# DISCORD_WEBHOOK_GRADES=        # daily grade summaries

# Second sportsbook source, for side-by-side comparison
# SPORTSGAMEODDS_API_KEY=
# ODDSPAPI_API_KEY=

# ── Deliberately unset: trading credentials ──────────────────
# Only needed once RFQs or automatic execution exist.
# KALSHI_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=       # path to the key file, never the key itself
